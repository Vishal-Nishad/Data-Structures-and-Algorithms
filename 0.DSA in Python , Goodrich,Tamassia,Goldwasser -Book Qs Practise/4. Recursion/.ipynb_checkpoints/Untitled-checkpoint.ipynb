   "source": [
    "# iterative fibonacci\n",
    "def it_fib(n):\n",
    "    if n==1:\n",
    "        return 1\n",
    "    else:\n",
    "        fib=0\n",
    "        a=0\n",
    "        b=1\n",
    "        for i in range(1,n):\n",
    "            fib=a+b\n",
    "            a=b\n",
    "            b=fib\n",
    "        return fib\n",
    "it_fib(6)\n",
    "            "
   ]
