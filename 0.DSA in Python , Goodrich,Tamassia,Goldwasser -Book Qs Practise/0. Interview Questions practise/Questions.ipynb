   "source": [
    "# GCD of two numbers\n",
    "def gcd(a,b):\n",
    "    while b!=0:\n",
    "        c=b\n",
    "        b=a%b\n",
    "        a=c\n",
    "    return a\n",
    "\n",
    "gcd(100,20)"
   ]
