   "source": [
    "# 1. Geometric sum\n",
    "def g_s(k):\n",
    "    if k==0:\n",
    "        return 1\n",
    "    return g_s(k-1)+1/(2**k)\n",
    "\n",
    "g_s(3)"
   ]
